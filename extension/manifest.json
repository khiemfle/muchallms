{
  "name": "Muchallms Grid Controller",
  "version": "0.2.21",
  "manifest_version": 3,
  "description": "Manage multiple LLM windows in a grid and broadcast prompts.",
  "action": {
    "default_title": "Muchallms Control",
    "default_icon": {
      "16": "src/icon-16.png",
      "32": "src/icon-32.png",
      "48": "src/icon-48.png",
      "128": "src/icon-128.png"
    }
  },
  "icons": {
    "16": "src/icon-16.png",
    "32": "src/icon-32.png",
    "48": "src/icon-48.png",
    "128": "src/icon-128.png"
  },
  "background": {
    "service_worker": "src/background.js"
  },
  "permissions": [
    "tabs",
    "windows",
    "storage",
    "system.display",
    "contextMenus",
    "scripting"
  ],
  "optional_host_permissions": [
    "https://*/*",
    "http://*/*"
  ],
  "host_permissions": [
    "https://chatgpt.com/*",
    "https://chat.openai.com/*",
    "https://claude.ai/*",
    "https://gemini.google.com/*",
    "https://grok.com/*",
    "https://x.com/i/grok*",
    "https://perplexity.ai/*",
    "https://www.perplexity.ai/*",
    "https://chat.deepseek.com/*",
    "https://deepseek.com/*",
    "https://poe.com/*",
    "https://www.poe.com/*",
    "https://huggingface.co/chat*",
    "https://openrouter.ai/*",
    "https://www.openrouter.ai/*",
    "https://chat.mistral.ai/*",
    "https://copilot.microsoft.com/*",
    "https://www.bing.com/*",
    "http://localhost/*",
    "http://127.0.0.1/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://chatgpt.com/*",
        "https://chat.openai.com/*",
        "https://claude.ai/*",
        "https://gemini.google.com/*",
        "https://grok.com/*",
        "https://x.com/i/grok*",
        "https://perplexity.ai/*",
        "https://www.perplexity.ai/*",
        "https://chat.deepseek.com/*",
        "https://deepseek.com/*",
        "https://poe.com/*",
        "https://www.poe.com/*",
        "https://huggingface.co/chat*",
        "https://openrouter.ai/*",
        "https://www.openrouter.ai/*",
        "https://chat.mistral.ai/*",
        "https://copilot.microsoft.com/*",
        "https://www.bing.com/*",
        "http://localhost/*",
        "http://127.0.0.1/*"
      ],
      "js": [
        "src/providers.js",
        "src/content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
